# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Telegram ---------------------------------------------------------------
# Create a bot with @BotFather, paste the token here.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id(s), comma-separated. Get yours from @userinfobot.
# If left empty, the bot is OPEN to anyone (dev only — set this for real use).
TELEGRAM_ALLOWED_USER_IDS=

# --- Model provider ---------------------------------------------------------
# Phase 0 uses Anthropic (see agent/models.yaml). Pay-as-you-go API key,
# separate from any consumer subscription. Set a spend cap in the console.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Behavior ---------------------------------------------------------------
# Kill switch: 'true' disables every side-effectful tool (writes, git push).
KILL_SWITCH=false
# Max model requests per turn (runaway-loop budget ceiling).
MAX_TURNS=12
# Push committed knowledge changes to the git 'origin' remote after each turn.
GIT_PUSH=false

# --- Observability (optional) ----------------------------------------------
# If set, traces + cost go to Logfire. Leave empty to disable.
LOGFIRE_TOKEN=
