# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Telegram (OPTIONAL) ------------------------------------------------------
# The iPhone app (PWA) is the primary surface and needs none of this.
# Leave TELEGRAM_BOT_TOKEN empty to run app-only. To ALSO enable the Telegram
# bot: create one with @BotFather and set both values (the allowlist is
# required whenever the bot is on — startup fails closed without it).
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id(s), comma-separated (from @userinfobot).
TELEGRAM_ALLOWED_USER_IDS=

# --- Model provider ---------------------------------------------------------
# Phase 0 uses Anthropic (see agent/models.yaml). Pay-as-you-go API key,
# separate from any consumer subscription. Set a spend cap in the console.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Behavior ---------------------------------------------------------------
# Kill switch: 'true' disables every side-effectful tool (writes, git push).
KILL_SWITCH=false
# Max model requests per turn (runaway-loop budget ceiling).
MAX_TURNS=12
# Hard daily ceiling on *estimated* model spend in USD; 0 disables the guard.
# Pricing per model lives in agent/models.yaml.
DAILY_BUDGET_USD=5
# Max messages of past conversation fed into each turn (0 = unlimited).
HISTORY_MAX_MESSAGES=60
# Startup fails if TELEGRAM_ALLOWED_USER_IDS is empty, unless you explicitly
# opt in to an open bot with DEV_MODE=true (local development only!).
DEV_MODE=false
# Push committed knowledge changes to the git 'origin' remote after each turn.
GIT_PUSH=false

# --- Deployment (Fly.io; see PLAN.md §9) -------------------------------------
# These are set as `fly secrets` / fly.toml env, NOT in a local .env:
#   PERSONAL_AI_DATA  volume mount (fly.toml sets /data); repo+sqlite live there
#   GIT_REMOTE_URL    where to clone the knowledge repo on first boot,
#                     e.g. git@github.com:you/personal-ai.git
#   GIT_SSH_KEY       contents of a write-scoped deploy key for that repo

# --- PWA (Phase 10; docs/PWA-DESIGN.md) --------------------------------------
# Public origin the app is served from. Passkeys bind to this domain, so it
# must match the URL you open on the phone. Fly: https://<app>.fly.dev.
PWA_ORIGIN=http://localhost:8080
# HTTP port for the PWA (Fly's internal_port must match).
PORT=8080

# --- Proactive scheduling (Phase 4) ----------------------------------------
# Nightly wiki synthesis + a morning briefing pushed to you on Telegram.
PROACTIVE_ENABLED=true
SYNTHESIS_HOUR=3      # local hour for the nightly inbox->wiki pass
BRIEFING_HOUR=8       # local hour for the morning briefing
# Where to push proactive messages. Defaults to your first allowed user id;
# only set this if the target chat id differs (e.g. a group).
# TELEGRAM_CHAT_ID=

# --- Observability (optional) ----------------------------------------------
# If set, traces + cost go to Logfire. Leave empty to disable.
LOGFIRE_TOKEN=
